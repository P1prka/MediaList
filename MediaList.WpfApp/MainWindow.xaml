<Window x:Class="MediaList.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaList"
        Height="720"
        Width="1100"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FB"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ColorButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource ColorButton}">
            <Setter Property="Background" Value="#10B981"/>
        </Style>

        <Style x:Key="IndigoButton" TargetType="Button" BasedOn="{StaticResource ColorButton}">
            <Setter Property="Background" Value="#6366F1"/>
        </Style>

        <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource ColorButton}">
            <Setter Property="Background" Value="#F59E0B"/>
        </Style>

        <Style x:Key="LightButton" TargetType="Button" BasedOn="{StaticResource ColorButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PinkButton" TargetType="Button" BasedOn="{StaticResource ColorButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#EC4899"/>
            <Setter Property="BorderBrush" Value="#F9A8D4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#EEF0FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E0E3FF"/>
                                <Setter Property="Foreground" Value="#3730A3"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="#3730A3"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box"
                                Background="White"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,6,0"
                                Padding="14,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#4F46E5"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#4F46E5" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RandomText}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button Content="🎲 What to watch tonight?"
                            Style="{StaticResource OrangeButton}"
                            Command="{Binding RandomCommand}"/>
                </StackPanel>
                <TextBlock Text="🎬 MediaList"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E3E7EF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10">
                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Type"
                                 IsChecked="{Binding ShowAll, Mode=TwoWay}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AllCount}" Foreground="#9CA3AF"/>
                            <TextBlock Text="📋 All"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Type"
                                 IsChecked="{Binding ShowMovies, Mode=TwoWay}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding MoviesCount}" Foreground="#9CA3AF"/>
                            <TextBlock Text="🎬 Movies"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Type"
                                 IsChecked="{Binding ShowSeries, Mode=TwoWay}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SeriesCount}" Foreground="#9CA3AF"/>
                            <TextBlock Text="📺 Series"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Type"
                                 IsChecked="{Binding ShowCartoons, Mode=TwoWay}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CartoonsCount}" Foreground="#9CA3AF"/>
                            <TextBlock Text="🧸 Cartoons"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Type"
                                 IsChecked="{Binding ShowFavorites, Mode=TwoWay}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding FavoritesCount}" Foreground="#9CA3AF"/>
                            <TextBlock Text="♥ Favorites"/>
                        </DockPanel>
                    </RadioButton>

                    <Border BorderBrush="#E3E7EF" BorderThickness="0,1,0,0" Margin="0,10"/>

                    <Button Content="➕ Add new"
                            Style="{StaticResource GreenButton}"
                            Margin="0"
                            Padding="10,8"
                            Command="{Binding ShowAddCommand}"/>

                    <TextBlock Text="{Binding Message}"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Margin="2,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#E3E7EF"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#E3E7EF" BorderThickness="0,0,0,1" Padding="8,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="150"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Search by title"/>
                                    <ComboBox Width="130"
                                              Margin="6,0,0,0"
                                              ItemsSource="{Binding SortOptions}"
                                              SelectedItem="{Binding SortMode}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource TabItemStyle}" GroupName="Status"
                                                 Content="{Binding WatchingTabText}"
                                                 IsChecked="{Binding ShowWatching, Mode=TwoWay}"/>
                                    <RadioButton Style="{StaticResource TabItemStyle}" GroupName="Status"
                                                 Content="{Binding WantToWatchTabText}"
                                                 IsChecked="{Binding ShowWantToWatch, Mode=TwoWay}"/>
                                    <RadioButton Style="{StaticResource TabItemStyle}" GroupName="Status"
                                                 Content="{Binding WatchedTabText}"
                                                 IsChecked="{Binding ShowWatched, Mode=TwoWay}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="Nothing here yet"
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Center"
                                   Margin="0,40,0,0"
                                   Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVis}}"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding VisibleItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EEF0F5" BorderThickness="0,0,0,1" Padding="12,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border x:Name="Icon"
                                                        Width="38"
                                                        Height="38"
                                                        CornerRadius="8"
                                                        Background="#DBEAFE"
                                                        Margin="0,0,12,0">
                                                    <TextBlock x:Name="IconText"
                                                               Text="🎬"
                                                               FontSize="18"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding InfoText}" Foreground="#9CA3AF" Margin="8,1,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,4,0,0"
                                                                Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding ProgressText}"
                                                                   Foreground="#4338CA"
                                                                   FontWeight="SemiBold"
                                                                   Width="110"/>
                                                        <ProgressBar Width="160"
                                                                     Height="6"
                                                                     Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                     Foreground="#6366F1"
                                                                     Background="#EEF0F6"
                                                                     BorderThickness="0"/>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding StarsText}"
                                                               Foreground="#F59E0B"
                                                               FontSize="14"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding IsWatched, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{Binding MainActionText}"
                                                            Style="{StaticResource GreenButton}"
                                                            Visibility="{Binding HasMainAction, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.MainActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Next season"
                                                            Style="{StaticResource IndigoButton}"
                                                            Visibility="{Binding HasNextSeason, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.NextSeasonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="★ Rate"
                                                            Style="{StaticResource OrangeButton}"
                                                            Visibility="{Binding IsWatched, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.RateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="{Binding FavoriteText}"
                                                            Style="{StaticResource PinkButton}"
                                                            ToolTip="Favorite"
                                                            Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="✏"
                                                            Style="{StaticResource LightButton}"
                                                            ToolTip="Edit"
                                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="🗑"
                                                            Style="{StaticResource LightButton}"
                                                            ToolTip="Delete"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding TypeName}" Value="Series">
                                                <Setter TargetName="Icon" Property="Background" Value="#E0E7FF"/>
                                                <Setter TargetName="IconText" Property="Text" Value="📺"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TypeName}" Value="Cartoon">
                                                <Setter TargetName="Icon" Property="Background" Value="#FEF3C7"/>
                                                <Setter TargetName="IconText" Property="Text" Value="🧸"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsAddMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="18" MaxWidth="560" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="← Back"
                                        Style="{StaticResource LightButton}"
                                        Margin="0"
                                        Command="{Binding CancelAddCommand}"/>
                                <TextBlock Text="{Binding FormTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentItem}" GroupName="NewType"
                                             Content="🎬 Movie"
                                             IsChecked="{Binding IsNewMovie, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource SegmentItem}" GroupName="NewType"
                                             Content="📺 Series"
                                             IsChecked="{Binding IsNewSeries, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource SegmentItem}" GroupName="NewType"
                                             Content="🧸 Cartoon"
                                             IsChecked="{Binding IsNewCartoon, Mode=TwoWay}"/>
                            </StackPanel>

                            <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Genre" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding GenreOptions}" SelectedItem="{Binding NewGenre}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Year" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding NewYearText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding NewStatus}"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#EEF0FF"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding IsNewSeries, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Seasons" Foreground="#3730A3" VerticalAlignment="Center"/>
                                        <TextBox Width="60"
                                                 Margin="8,0,0,0"
                                                 Text="{Binding SeasonsCountText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <TextBlock Text="Episodes in each season"
                                               Foreground="#3730A3"
                                               FontSize="12"
                                               Margin="0,10,0,4"/>

                                    <ItemsControl ItemsSource="{Binding SeasonInputs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,8,6">
                                                    <TextBlock Text="{Binding Label}" Foreground="#3730A3" FontSize="11"/>
                                                    <TextBox Width="60" Text="{Binding EpisodesText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,6,0,0"
                                                Visibility="{Binding ShowCurrentPosition, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Now at season" Foreground="#3730A3" VerticalAlignment="Center"/>
                                        <TextBox Width="50" Margin="6,0" Text="{Binding CurrentSeasonText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="episode" Foreground="#3730A3" VerticalAlignment="Center"/>
                                        <TextBox Width="50" Margin="6,0" Text="{Binding CurrentEpisodeText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding ErrorText}"
                                       Foreground="#DC2626"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Save"
                                        Style="{StaticResource GreenButton}"
                                        Margin="0"
                                        Padding="20,7"
                                        Command="{Binding SaveNewCommand}"/>
                                <Button Content="Cancel"
                                        Style="{StaticResource LightButton}"
                                        Margin="8,0,0,0"
                                        Padding="16,7"
                                        Command="{Binding CancelAddCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>